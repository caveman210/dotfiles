# --- PERMANENT TRANSPARENT BACKGROUND ---
# Keeps the window padding fully transparent across all modes
set default-bg rgba(0,0,0,0)
set statusbar-bg rgba(0,0,0,0)

# --- STARTUP STATE (Mode 1: Opaque White Page) ---
set recolor true
set recolor-lightcolor "#ffffff"
set recolor-darkcolor "#1a1a1a"

# --- THE TOGGLE BINDINGS (Runtime Configuration Changes) ---
# Pressing 't' inputs internal commands to instantly make the page transparent
map t feedkeys ":set recolor-lightcolor rgba(0,0,0,0)<Return>:set recolor-darkcolor rgba(255,255,255,1)<Return>"

# Pressing 'T' (Shift+t) inputs internal commands to snap it back to solid white
map T feedkeys ":set recolor-lightcolor \#ffffff<Return>:set recolor-darkcolor \#1a1a1a<Return>"

