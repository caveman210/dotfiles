
# Swaylock-effects config styled with Matugen

screenshots
clock
indicator
show-failed-attempts

# Frosted blurred desktop background (downscale + fast blur)
effect-scale=0.7
effect-blur=3x2
effect-vignette=0.4:0.6
fade-in=0.15

font="JetBrainsMono Nerd Font"
timestr=%H:%M
datestr=%A, %d %B %Y

# Compact, minimal dial
indicator-radius=110
indicator-thickness=7
indicator-caps-lock

# Transparent fills to highlight the blurred screenshot
inside-color=00000000
inside-clear-color=00000000
inside-ver-color=b5c9d622
inside-wrong-color=ffb4ab33
separator-color=00000000

# Sleek rings & outline hierarchy
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

ring-color=43474b88
key-hl-color=b5c9d6
bs-hl-color=ffb4ab

ring-ver-color=b5c9d6
ring-clear-color=e4bfa7
ring-wrong-color=ffb4ab

# Typography
text-color=e4e2e2
text-clear-color=e4bfa7
text-ver-color=b5c9d6
text-wrong-color=ffb4ab
text-caps-lock-color=e4bfa7

grace=2
grace-no-mouse
grace-no-touch


