[config]
# Matugen configuration — wallpaper-driven theming.

[templates.kitty]
input_path = "~/.config/matugen/templates/kitty.conf"
output_path = "~/.config/kitty/current-theme.conf"

[templates.quickshell]
input_path = "~/.config/matugen/templates/quickshell-colors.qml"
output_path = "~/.config/quickshell/colors/MatugenColors.qml"

[templates.nvim]
input_path = "~/.config/matugen/templates/nvim.lua"
output_path = "~/.config/nvim/lua/config/matugen.lua"

[templates.gtk3]
input_path = "~/.config/matugen/templates/gtk.css"
output_path = "~/.config/gtk-3.0/gtk.css"

[templates.gtk4]
input_path = "~/.config/matugen/templates/gtk.css"
output_path = "~/.config/gtk-4.0/gtk.css"

[templates.vicinae]
input_path = "~/.config/matugen/templates/vicinae.toml"
output_path = "~/.config/vicinae/themes/matugen.toml"

[templates.zen]
input_path = "~/.config/matugen/templates/zen-userChrome.css"
output_path = "~/.config/zen/default/chrome/userChrome.css"
