
# Swaylock-effects config styled with Matugen

screenshots
clock
indicator
show-failed-attempts

# Frosted blurred desktop background (downscale + fast blur)
effect-scale=0.7
effect-blur=3x2
effect-vignette=0.4:0.6
fade-in=0.15

font="JetBrainsMono Nerd Font"
timestr=%H:%M
datestr=%A, %d %B %Y

# Compact, minimal dial
indicator-radius=110
indicator-thickness=7
indicator-caps-lock

# Transparent fills to highlight the blurred screenshot
inside-color=00000000
inside-clear-color=00000000
inside-ver-color={{ colors.primary.default.hex_stripped }}22
inside-wrong-color={{ colors.error.default.hex_stripped }}33
separator-color=00000000

# Sleek rings & outline hierarchy
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

ring-color={{ colors.outline_variant.default.hex_stripped }}88
key-hl-color={{ colors.primary.default.hex_stripped }}
bs-hl-color={{ colors.error.default.hex_stripped }}

ring-ver-color={{ colors.primary.default.hex_stripped }}
ring-clear-color={{ colors.tertiary.default.hex_stripped }}
ring-wrong-color={{ colors.error.default.hex_stripped }}

# Typography
text-color={{ colors.on_surface.default.hex_stripped }}
text-clear-color={{ colors.tertiary.default.hex_stripped }}
text-ver-color={{ colors.primary.default.hex_stripped }}
text-wrong-color={{ colors.error.default.hex_stripped }}
text-caps-lock-color={{ colors.tertiary.default.hex_stripped }}

grace=2
grace-no-mouse
grace-no-touch


