# Matugen theme for btop
# Generated dynamically by matugen

# Main background, empty for terminal default, or hex code if non empty
theme[main_bg]="{{colors.surface.default.hex}}"

# Main text color
theme[main_fg]="{{colors.on_surface.default.hex}}"

# Title color for boxes
theme[title]="{{colors.primary.default.hex}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{colors.secondary.default.hex}}"

# Background color of selected item in lists
theme[selected_bg]="{{colors.surface_container_high.default.hex}}"

# Foreground color of selected item in lists
theme[selected_fg]="{{colors.on_surface.default.hex}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{colors.outline.default.hex}}"

# Color of text appearing on top of graphs, i.e uptime and current network stats
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{colors.primary.default.hex}}"

# Cpu box outline color
theme[cpu_box]="{{colors.outline_variant.default.hex}}"

# Memory/disks box outline color
theme[mem_box]="{{colors.outline_variant.default.hex}}"

# Net box outline color
theme[net_box]="{{colors.outline_variant.default.hex}}"

# Processes box outline color
theme[proc_box]="{{colors.outline_variant.default.hex}}"

# Box divider line and small boxes line color
theme[div_line]="{{colors.outline_variant.default.hex}}"

# Temperature graph colors
theme[temp_start]="{{colors.secondary.default.hex}}"
theme[temp_mid]="{{colors.tertiary.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

# CPU graph colors
theme[cpu_start]="{{colors.secondary.default.hex}}"
theme[cpu_mid]="{{colors.primary.default.hex}}"
theme[cpu_end]="{{colors.error.default.hex}}"

# Mem colors
theme[free_start]="{{colors.secondary.default.hex}}"
theme[free_mid]="{{colors.primary.default.hex}}"
theme[free_end]="{{colors.primary_container.default.hex}}"

# Mem cached meter
theme[cached_start]="{{colors.tertiary.default.hex}}"
theme[cached_mid]="{{colors.secondary.default.hex}}"
theme[cached_end]="{{colors.primary.default.hex}}"

# Mem available meter
theme[available_start]="{{colors.secondary.default.hex}}"
theme[available_mid]="{{colors.primary.default.hex}}"
theme[available_end]="{{colors.primary_container.default.hex}}"

# Mem used meter
theme[used_start]="{{colors.secondary.default.hex}}"
theme[used_mid]="{{colors.tertiary.default.hex}}"
theme[used_end]="{{colors.error.default.hex}}"

# Download graph colors
theme[download_start]="{{colors.secondary.default.hex}}"
theme[download_mid]="{{colors.primary.default.hex}}"
theme[download_end]="{{colors.tertiary.default.hex}}"

# Upload graph colors
theme[upload_start]="{{colors.tertiary.default.hex}}"
theme[upload_mid]="{{colors.primary_container.default.hex}}"
theme[upload_end]="{{colors.error.default.hex}}"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="{{colors.secondary.default.hex}}"
theme[process_mid]="{{colors.primary.default.hex}}"
theme[process_end]="{{colors.error.default.hex}}"
